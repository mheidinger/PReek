{
  "sourceLanguage" : "en",
  "strings" : {
    "Choose an existing local clone" : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Vorhandenen lokalen Klon auswählen" } } }
    },
    "Select your existing clone of %@. PReek never clones repositories automatically." : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Wähle deinen vorhandenen Klon von %@ aus. PReek klont Repositorys niemals automatisch." } } }
    },
    "Use Clone" : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Klon verwenden" } } }
    },
    "Could not complete local action" : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Lokale Aktion konnte nicht abgeschlossen werden" } } }
    },
    "PR workspace update skipped" : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktualisierung des PR-Workspaces übersprungen" } } }
    },
    "Open Unchanged" : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Unverändert öffnen" } } }
    },
    "Force Update…" : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktualisierung erzwingen…" } } }
    },
    "Discard all local workspace data?" : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Alle lokalen Workspace-Daten verwerfen?" } } }
    },
    "Before continuing, stop ALL processes using %@, including editors, agents, builds, terminals, and Git operations. Force update removes and recreates this checkout at the latest PR revision. This deletes ALL uncommitted edits, staged changes, untracked and ignored files, local submodule data, unfinished Git operations, and worktree locks. The current committed HEAD is retained in a backup ref. This cannot be undone for uncommitted data." : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Beende vor dem Fortfahren ALLE Prozesse, die %@ verwenden, einschließlich Editoren, Agenten, Builds, Terminals und Git-Operationen. Die erzwungene Aktualisierung entfernt diesen Checkout und erstellt ihn mit der neuesten PR-Revision neu. Dabei werden ALLE nicht committeten Änderungen, Änderungen im Index, nicht versionierten und ignorierten Dateien, lokalen Submoduldaten, unvollendeten Git-Operationen und Worktree-Sperren gelöscht. Der aktuell committete HEAD bleibt in einer Backup-Referenz erhalten. Für nicht committete Daten kann dies nicht rückgängig gemacht werden." } } }
    },
    "Discard Local Data and Update" : {
      "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Lokale Daten verwerfen und aktualisieren" } } }
    },
