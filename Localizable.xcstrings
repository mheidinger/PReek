    },
    "connection-settings.pat.explanation" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Personal Access Token (PAT) sollte vom Typ 'Classic' sein und benötigt die Berechtigung 'notifications'. Für den Zugriff auf private Repositorys ist zusätzlich die Berechtigung 'repo' erforderlich. Benachrichtigungen werden verwendet, um die für dich relevanten Pull Requests zu identifizieren. Informationen zum Erstellen eines PAT findest du in der [GitHub-Dokumentation](https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens#creating-a-personal-access-token-classic)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Personal Access Token (PAT) should be of type 'classic' and requires the 'notifications' scope. For access to private repositories, additionally the 'repo' scope is required. Notifications are used to get the Pull Requests that are shown yo you. See the [GitHub documentation](https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens#creating-a-personal-access-token-classic) on how to generate a PAT."
          }
        }
      }
    },
    "connection-settings.pat.label" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub PAT"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub PAT"
          }
        }
      }
