    },
    "The executable must be an absolute path." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausführbare Datei muss als absoluter Pfad angegeben werden."
          }
        }
      }
    },
    "The existing PR workspace has no saved name. Nothing was changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der vorhandene PR-Arbeitsbereich hat keinen gespeicherten Namen. Es wurde nichts geändert."
          }
        }
      }
    },
    "The existing checkout state is redirected or not owned by this account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Status des vorhandenen Checkouts wird umgeleitet oder gehört nicht diesem Benutzerkonto."
