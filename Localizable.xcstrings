    },
    "Requires Git and a configured GitHub account. Agent actions also require Ghostty 1.3 or newer and OMP. PReek prepares the shared PR worktree before opening either application." : {
      "comment" : "A description of the requirements for local editor and agent actions.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert Git und ein eingerichtetes GitHub-Konto. Agentenaktionen benötigen zusätzlich Ghostty 1.3 oder neuer und OMP. PReek bereitet den gemeinsamen PR-Worktree vor, bevor die jeweilige Anwendung geöffnet wird."
          }
        }
      }
    },
