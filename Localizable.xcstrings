{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\n\nInstall Ghostty 1.3 or newer with AppleScript enabled, and allow PReek to control Ghostty in System Settings → Privacy & Security → Automation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nInstalliere Ghostty 1.3 oder neuer mit aktiviertem AppleScript und erlaube PReek unter Systemeinstellungen → Datenschutz & Sicherheit → Automation, Ghostty zu steuern."
          }
        }
      }
    },
    "%@ exited with status %lld%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde mit Status %lld%@ beendet"
          }
        }
      }
    },
    "%@ must be an absolute path or begin with ~/." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muss ein absoluter Pfad sein oder mit ~/ beginnen."
          }
        }
      }
    },
    "A Git operation is in progress or the worktree is locked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Git-Operation läuft oder der Worktree ist gesperrt."
          }
        }
      }
    },
    "A Git operation owns shared repository metadata." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Git-Operation hält die gemeinsamen Repository-Metadaten gesperrt."
          }
        }
      }
    },
    "A review thread's replies are unavailable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antworten eines Review-Threads sind nicht verfügbar."
          }
        }
      }
    },
    "Address comments" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommentare bearbeiten"
          }
        }
      }
    },
    "An existing folder occupies the PR workspace. Nothing was overwritten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein vorhandener Ordner belegt den PR-Arbeitsbereich. Es wurde nichts überschrieben."
          }
        }
      }
    },
    "An unmanaged folder occupies the PR workspace. Nothing was overwritten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein nicht verwalteter Ordner belegt den PR-Arbeitsbereich. Es wurde nichts überschrieben."
          }
        }
      }
    },
    "Choose the root of an existing local Git clone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Stammverzeichnis eines vorhandenen lokalen Git-Klons."
          }
        }
      }
    },
    "Could not construct the PR head repository URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die URL des PR-Head-Repositorys konnte nicht erstellt werden."
          }
        }
      }
    },
    "Could not inspect the PR history: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der PR-Verlauf konnte nicht überprüft werden: %@"
          }
        }
      }
    },
    "Could not inspect the checkout branch: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Checkout-Branch konnte nicht überprüft werden: %@"
          }
        }
      }
    },
    "Could not inspect the existing checkout history: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verlauf des vorhandenen Checkouts konnte nicht überprüft werden: %@"
          }
        }
      }
    },
    "Could not inspect the pending PR commits: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausstehenden PR-Commits konnten nicht überprüft werden: %@"
          }
        }
      }
    },
    "Could not prepare the Ghostty command." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ghostty-Befehl konnte nicht vorbereitet werden."
          }
        }
      }
    },
    "Custom action" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Aktion"
          }
        }
      }
    },
    "Editor unavailable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor nicht verfügbar"
          }
        }
      }
    },
    "Enter a prompt for this action in Settings before launching it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib vor dem Starten in den Einstellungen einen Prompt für diese Aktion ein."
          }
        }
      }
    },
    "Enter the OMP executable path in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib in den Einstellungen den Pfad zur ausführbaren OMP-Datei ein."
          }
        }
      }
    },
    "Expected an HTTPS GitHub pull request URL with an owner, repository, and PR number." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwartet wird eine HTTPS-GitHub-Pull-Request-URL mit Besitzer, Repository und PR-Nummer."
          }
        }
      }
    },
    "Force update is only available for PReek-managed worktrees. Your existing checkout was not changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erzwungene Aktualisierung ist nur für von PReek verwaltete Worktrees verfügbar. Dein vorhandener Checkout wurde nicht geändert."
          }
        }
      }
    },
    "Git did not return the requested PR base commit %@. Nothing was updated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git hat den angeforderten PR-Basis-Commit %@ nicht zurückgegeben. Es wurde nichts aktualisiert."
          }
        }
      }
    },
    "GitHub repeated a discussion pagination URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat eine Seitennavigations-URL der Diskussion wiederholt."
          }
        }
      }
    },
    "GitHub returned a different repository or pull request. Check the repository mapping." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat ein anderes Repository oder einen anderen Pull Request zurückgegeben. Prüfe die Repository-Zuordnung."
          }
        }
      }
    },
    "GitHub returned a missing or repeated pagination cursor." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat einen fehlenden oder wiederholten Seitennavigations-Cursor zurückgegeben."
          }
        }
      }
    },
    "GitHub returned an invalid PR head repository." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat ein ungültiges PR-Head-Repository zurückgegeben."
          }
        }
      }
    },
    "GitHub returned an unexpected API or pagination URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat eine unerwartete API- oder Seitennavigations-URL zurückgegeben."
          }
        }
      }
    },
    "GitHub returned invalid PR commit SHAs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat ungültige PR-Commit-SHAs zurückgegeben."
          }
        }
      }
    },
    "GitHub returned no review thread data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat keine Daten zu Review-Threads zurückgegeben."
          }
        }
      }
    },
    "GitHub's API and Git remote disagree on PR #%lld after %lld attempts (API head: %@; Git head: %@). Nothing was updated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die GitHub-API und das Git-Remote stimmen bei PR #%lld nach %lld Versuchen nicht überein (API-Head: %@; Git-Head: %@). Es wurde nichts aktualisiert."
          }
        }
      }
    },
    "HEAD changed before its update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD hat sich vor der Aktualisierung geändert."
          }
        }
      }
    },
    "HEAD changed while fetching." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEAD hat sich während des Abrufs geändert."
          }
        }
      }
    },
    "Index flags can hide local changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Index-Flags können lokale Änderungen verbergen."
          }
        }
      }
    },
    "No HTTPS/SSH fetch remote matches %@. Check the mapped clone; no repository was cloned." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein HTTPS-/SSH-Fetch-Remote passt zu %@. Überprüfe den zugeordneten Klon; es wurde kein Repository geklont."
          }
        }
      }
    },
    "Open in %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@ öffnen"
          }
        }
      }
    },
    "Pending preparation cannot finish safely: %@ Preserve or resolve the local data before retrying." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausstehende Vorbereitung kann nicht sicher abgeschlossen werden: %@ Sichere oder bereinige die lokalen Daten vor einem erneuten Versuch."
          }
        }
      }
    },
    "Please verify you are using the latest version of the app on both devices. If the issue persists, please report the issue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob du auf beiden Geräten die neueste Version der App verwendest. Wenn das Problem weiterhin besteht, melde es bitte."
          }
        }
      }
    },
    "Review PR" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR überprüfen"
          }
        }
      }
    },
    "Select an installed editor in Settings → Local actions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle unter Einstellungen → Lokale Aktionen einen installierten Editor aus."
          }
        }
      }
    },
    "State for an existing checkout must be outside its repository and Git metadata." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Status eines vorhandenen Checkouts muss außerhalb seines Repositorys und seiner Git-Metadaten liegen."
          }
        }
      }
    },
    "The PR branch changed before its update. Nothing was reset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der PR-Branch hat sich vor der Aktualisierung geändert. Es wurde nichts zurückgesetzt."
          }
        }
      }
    },
    "The PR branch changed while finishing preparation. Nothing was overwritten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der PR-Branch hat sich beim Abschließen der Vorbereitung geändert. Es wurde nichts überschrieben."
          }
        }
      }
    },
    "The PR branch has multiple worktree registrations. Nothing was changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der PR-Branch hat mehrere Worktree-Registrierungen. Es wurde nichts geändert."
          }
        }
      }
    },
    "The PR branch is already registered at %@. Nothing was overwritten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der PR-Branch ist bereits unter %@ registriert. Es wurde nichts überschrieben."
          }
        }
      }
    },
    "The PR branch is checked out elsewhere. Nothing was removed." : {
      "localizations" : {
        "de" : {
