    "Runs locally in Ghostty. Local changes are preserved unless you explicitly confirm Force Update. The agent is instructed not to push or post to GitHub." : {
      "comment" : "A description of the local agent.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft lokal in Ghostty. Lokale Änderungen bleiben erhalten, sofern du eine erzwungene Aktualisierung nicht ausdrücklich bestätigst. Der Agent wird angewiesen, keine Änderungen zu pushen oder Beiträge auf GitHub zu veröffentlichen."
          }
        }
      }
    },
    "Save as a reusable action" : {
      "comment" : "A toggle that allows the user to save the current prompt as a reusable action.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als wiederverwendbare Aktion speichern"
          }
        }
      }
    },
    "Saved actions launch with one click from a pull request. Prompts are editable and saved automatically. All actions are instructed to preserve local changes and never push or post to GitHub." : {
      "comment" : "A description of the local agent's saved actions.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Aktionen lassen sich mit einem Klick aus einem Pull Request starten. Prompts können bearbeitet werden und werden automatisch gespeichert. Alle Aktionen werden angewiesen, lokale Änderungen zu erhalten und keine Änderungen zu pushen oder Beiträge auf GitHub zu veröffentlichen."
          }
        }
      }
